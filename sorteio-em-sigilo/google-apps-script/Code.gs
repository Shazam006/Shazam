function doGet() {
 return HtmlService.createHtmlOutput(HTML_).setTitle('Sorteio em Sigilo').addMetaTag('viewport','width=device-width, initial-scale=1');
}
function field_(value,max,required) {
 if(typeof value!=='string')throw Error('Campo inválido.');
 value=value.trim();
 if(value.length>max||(required&&!value)||/[\u0000-\u001f\u007f]/.test(value))throw Error('Campo inválido ou muito longo.');
 return value;
}
function draw_(n) {
 const p=Array.from({length:n},(_,i)=>i);
 do {for(let i=n-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[p[i],p[j]]=[p[j],p[i]];}}while(p.some((v,i)=>v===i));
 return p;
}
function token_(){return (Utilities.getUuid()+Utilities.getUuid()).replace(/-/g,'').toLowerCase();}
function hash_(token){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token,Utilities.Charset.UTF_8).map(v=>('0'+((v+256)%256).toString(16)).slice(-2)).join('');}
function drawApi(d) {
 try{
 if(!d||typeof d!=='object'||Array.isArray(d))throw Error('Pedido inválido.');
 const store=PropertiesService.getScriptProperties();
 const url=ScriptApp.getService().getUrl();
 if(!url||!url.endsWith('/exec'))throw Error('Publique uma implantação do tipo aplicativo da Web.');
 if(d.action==='create'){
  if(!Array.isArray(d.names)||d.names.length<2||d.names.length>100)throw Error('Informe de 2 a 100 participantes.');
  const names=d.names.map(n=>field_(n,80,true)),norm=n=>n.normalize('NFKC').toLocaleLowerCase('pt-BR').replace(/\s+/g,' ');
  if(new Set(names.map(norm)).size!==names.length)throw Error('Existem nomes duplicados.');
  const event=field_(d.event,100,true),date=field_(d.date||'',10),budget=field_(d.budget||'',60);
  if(date){const dt=new Date(date+'T00:00:00Z');if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!Number.isFinite(dt.getTime())||dt.toISOString().slice(0,10)!==date)throw Error('Data inválida.');}
  const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('Serviço ocupado. Tente novamente.');
  try {
   const now=Date.now(),exp=now+90*86400000,p=draw_(names.length),records=[],batch={},existing=store.getProperties();
   let activeBytes=0;
   for(const k in existing){
    if(k.startsWith('invite:')){let x;try{x=JSON.parse(existing[k])}catch{}if(!x||x.exp<=now){store.deleteProperty(k);delete existing[k];continue;}}
    activeBytes+=Utilities.newBlob(k+existing[k]).getBytes().length;
   }
   for(let i=0;i<names.length;i++){
    let token,k;do{token=token_();k='invite:'+hash_(token);}while(existing[k]||batch[k]);
    batch[k]=JSON.stringify({event,date,budget,from:names[i],to:names[p[i]],exp});
    activeBytes+=Utilities.newBlob(k+batch[k]).getBytes().length;
    records.push({name:names[i],token});
   }
   if(activeBytes>440000)throw Error('Armazenamento ocupado. Tente novamente após expiração de convites.');
   store.setProperties(batch,false);
   return {records,url};
  }finally{lock.releaseLock();}
 }
 if(d.action==='preview'||d.action==='reveal'){
  const token=field_(d.token,64,true);
  if(!/^[0-9a-f]{64}$/.test(token))throw Error('Convite inválido.');
  const raw=store.getProperty('invite:'+hash_(token));
  if(!raw)throw Error('Convite inválido ou expirado.');
  const v=JSON.parse(raw);if(v.exp<=Date.now())throw Error('Convite expirado.');
  const out={event:v.event,date:v.date,budget:v.budget,from:v.from,url};
  if(d.action==='reveal')out.to=v.to;
  return out;
 }
 throw Error('Operação inexistente.');
 }catch(e){return {error:e instanceof Error&&/^(Campo|Pedido|Informe|Existem|Data|Publique|Serviço ocupado|Armazenamento|Convite|Operação)/.test(e.message)?e.message:'Não foi possível concluir a operação.'};}
}

